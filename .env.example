# CareBridge Backend Environment Configuration Template
PROJECT_NAME="CareBridge"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication (Generate secure secret in production)
SECRET_KEY="carebridge-insecure-dev-secret-key-replace-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default development database is asynchronous SQLite for ease of evaluation.
# Production / PostgreSQL target: postgresql+asyncpg://postgres:postgres@localhost:5432/carebridge
DATABASE_URL="sqlite+aiosqlite:///./carebridge.db"

# CORS Configuration (JSON array of allowed origins, never wildcards by default)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Configurable Delivery Methods (Subject to team approval)
SUPPORTED_DELIVERY_METHODS='["COMMUNITY_HEALTH_WORKER","VOLUNTEER","LOCAL_COURIER"]'

# Simulation Transparency Flag
IS_SIMULATED=True

# IVR & Voice Access Settings
IVR_API_KEY="dev-ivr-secret-key-carebridge-2026"
IVR_PROVIDER="mock"
IVR_SESSION_TIMEOUT_MINUTES=10
IVR_MAX_AUTH_ATTEMPTS=3
IVR_AUTH_LOCKOUT_MINUTES=15
IVR_DEFAULT_LANGUAGE="ta"
IVR_AUDIO_BASE_URL=""
IVR_EMERGENCY_NUMBER="108"
IVR_ALLOW_DEMO_PHONE_PIN=true
IVR_ENABLE_OUTBOUND_CALLBACKS=false
IVR_ENABLE_CALL_TRANSFER=false
IVR_TRANSFER_PHONE_NUMBER=""
IVR_ENABLE_CALL_RECORDING=false

# Telecom Provider Settings (Twilio Programmable Voice / Exotel / Mock)
TELEPHONY_PROVIDER="mock"
TELEPHONY_ENABLED=false
TELEPHONY_ACCOUNT_SID="AC_your_twilio_account_sid_here"
TELEPHONY_AUTH_TOKEN="your_twilio_auth_token_here"
TELEPHONY_API_KEY=""
TELEPHONY_API_SECRET=""
TELEPHONY_PHONE_NUMBER="+919876500000"
TELEPHONY_WEBHOOK_BASE_URL="https://your-domain.ngrok-free.app"
TELEPHONY_WEBHOOK_SECRET="your_webhook_signing_secret"
TELEPHONY_CALL_TIMEOUT=30
TELEPHONY_MAX_CALL_DURATION=600
